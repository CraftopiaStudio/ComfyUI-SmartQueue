__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
*.log
.DS_Store
*.sqlite3
.pytest_cache/

# User-picked notification sounds, copied in by backend/sound_library.py
web/sounds/custom/

# Internal planning, spec and analysis docs, not meant for the public repo.
# Deny the whole tree and allow back only the screenshots the README embeds.
# Naming each folder is what failed before: docs/analysis/ did not exist when
# that list was written, so it was never covered and reached a public branch.
# A new subfolder is now private by default and has to be allowed on purpose.
docs/*
!docs/images/

# Local Claude Code session/config data — never intended for the repo
.claude/

# Working design source for the icon, not part of the published node package.
docs/images/iconSQ.svg

# Local dev-only tooling, not part of the published node package.
# Globbed rather than named: these get copied per-project with a suffix
# (e.g. "check_registry_status - smartqueue.bat"), and a missed variant is
# how internal files end up tracked.
check_registry_status*
registry_status_last*
